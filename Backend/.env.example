# ---- copy this file to .env and adjust ----
NODE_ENV=development
PORT=4000
# PostgreSQL connection (create an empty database called mlm first)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlm?schema=public
# Frontend address(es) allowed to call the API (comma-separated)
WEB_ORIGIN=http://localhost:5173
# lax = Frontend and Backend on the same site (default). none = different domains (HTTPS required)
COOKIE_SAMESITE=lax
# Use long random strings in production
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Secret used to encrypt PAN / bank numbers at rest (any long random string)
ENCRYPTION_SECRET=dev_encryption_secret_change_me
UPLOAD_DIR=uploads
# DEMO mode: payments are simulated with a "Pay now (demo)" button
DEMO_PAYMENTS=true

# ---- Super Admin login OTP ----
# Every Super Admin sign-in needs a 6-digit OTP sent by SMS (set to false to switch off)
SUPER_ADMIN_OTP=true
# Mobile number that receives the Super Admin OTP (empty = the Super Admin's own registered mobile)
SUPER_ADMIN_OTP_MOBILE=+917250227201
OTP_EXPIRY_MINUTES=5

# ---- SMS gateway (for the OTP) ----
# console  = no SMS; the OTP is printed in the server log (and shown on screen in development)
# fast2sms = SMS_API_KEY (+ SMS_SENDER_ID and SMS_TEMPLATE_ID for the DLT route)
# msg91    = SMS_API_KEY (authkey) + SMS_TEMPLATE_ID (OTP template id)
# twilio   = TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
