# ---- copy this file to .env and adjust ----
NODE_ENV=development
PORT=4000
# PostgreSQL connection (create an empty database called mlm first)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlm?schema=public
# Frontend address(es) allowed to call the API (comma-separated)
WEB_ORIGIN=http://localhost:5173
# lax = Frontend and Backend on the same site (default). none = different domains (HTTPS required)
COOKIE_SAMESITE=lax
# Use long random strings in production
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Secret used to encrypt PAN / bank numbers at rest (any long random string)
ENCRYPTION_SECRET=dev_encryption_secret_change_me
UPLOAD_DIR=uploads
# DEMO mode: payments are simulated with a "Pay now (demo)" button
DEMO_PAYMENTS=true
