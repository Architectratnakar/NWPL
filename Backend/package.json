{
  "name": "mlm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MLM Portal Backend \u2014 Node.js REST API (Express + Prisma + PostgreSQL + Swagger)",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:extras": "prisma db execute --file prisma/sql/extras.sql --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "db:check": "tsx scripts/db-check.ts",
    "seed": "tsx prisma/seed.ts",
    "start:prod": "node scripts/prepare-db.js && node dist/server.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "1.4.13",
    "@types/node": "22.20.5",
    "@types/swagger-ui-express": "4.1.8",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "prisma": "6.19.3",
    "swagger-ui-express": "5.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20 <25"
  }
}
