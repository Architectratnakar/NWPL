// MLM Portal — Prisma schema (Prisma 6)
// Optional extra DB rules (triggers, check constraints, views): prisma/sql/extras.sql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------
enum Role {
  MEMBER
  FRANCHISE
  ADMIN_SUPER
  ADMIN_OPS
  ADMIN_FINANCE
  COMPLIANCE
  SUPPORT
}
enum Side {
  LEFT
  RIGHT
}
enum MemberStatus {
  REGISTERED
  ACTIVE
  BLOCKED
  TERMINATED
}
enum PackageTier {  // NONE = inactive, BASIC = 40 BV, FULL = 100 BV
  NONE
  BASIC
  FULL
}
enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}
enum KycDocType {
  PAN
  AADHAAR
  PHOTO
  BANK_PROOF
  DISABILITY_CERT
  OTHER
}
enum OrderType {
  JOINING
  UPGRADE
  REPURCHASE
  RETAIL
}
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  INVOICED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}
enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
}
enum ClosingStatus {
  DRAFT
  PREVIEWED
  APPROVED
  POSTED
  FAILED
}
enum IncomeType {
  PAIR_MATCHING
  RANK_BONUS
  SPECIAL_BONUS
  RETAIL_PROFIT
  LEADERSHIP
  ROYALTY
  LEVEL_REWARD
  AUTOPOOL
  ADJUSTMENT
}
enum WalletTxnType {
  CREDIT
  DEBIT
}
enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}
enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}
enum PendingActionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- USERS & MEMBERS ----------
model User {
  id           String    @id @default(cuid())
  mobile       String    @unique
  email        String?   @unique
  passwordHash String
  role         Role      @default(MEMBER)
  isActive     Boolean   @default(true)
  totpSecretEnc String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  member       Member?
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  @@index([userId])
}

model OtpCode {
  id        String    @id @default(cuid())
  mobile    String
  purpose   String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([mobile, purpose])
}

model Member {
  id               String        @id @default(cuid())
  distributorCode  String        @unique              // NW100001
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id])
  fullName         String
  gender           String?
  dob              DateTime?
  address          Json?
  // tree
  sponsorId        String?
  sponsor          Member?       @relation("Sponsor", fields: [sponsorId], references: [id])
  directs          Member[]      @relation("Sponsor")
  parentId         String?
  parent           Member?       @relation("Placement", fields: [parentId], references: [id])
  children         Member[]      @relation("Placement")
  side             Side?
  level            Int           @default(0)          // depth from root
  // status
  status           MemberStatus  @default(REGISTERED)
  packageTier      PackageTier   @default(NONE)
  activatedAt      DateTime?
  upgradedAt       DateTime?
  kycStatus        KycStatus     @default(NOT_SUBMITTED)
  specialBonusVerified Boolean   @default(false)      // women / divyang, verified by admin
  currentRankId    Int?
  currentRank      Rank?         @relation(fields: [currentRankId], references: [id])
  agreementVersion String?
  agreementAcceptedAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  volume           NodeVolume?
  bank             BankAccount?
  nominee          Nominee?
  kycDocs          KycDocument[]
  orders           Order[]
  wallet           Wallet?
  ranks            MemberRank[]
  closingLines     ClosingLine[]
  tickets          Ticket[]
  bvPostings       BvPosting[]

  @@unique([parentId, side])                         // one member per slot
  @@index([sponsorId])
}

model NodeVolume {
  memberId        String   @id
  member          Member   @relation(fields: [memberId], references: [id])
  // lifetime totals (used for ranks)
  totalLeftBv     Decimal  @default(0) @db.Decimal(14, 2)
  totalRightBv    Decimal  @default(0) @db.Decimal(14, 2)
  totalLeftCount  Int      @default(0)
  totalRightCount Int      @default(0)
  // unmatched pair units carried forward (by tier)
  carryLeftFull   Int      @default(0)
  carryLeftBasic  Int      @default(0)
  carryRightFull  Int      @default(0)
  carryRightBasic Int      @default(0)
  // cap counters
  pairsToday      Int      @default(0)
  pairsThisWeek   Int      @default(0)
  pairsThisMonth  Int      @default(0)
  capDay          DateTime?               // date the counters belong to
  updatedAt       DateTime @updatedAt
}

model BankAccount {
  memberId      String   @id
  member        Member   @relation(fields: [memberId], references: [id])
  holderName    String
  accountNoEnc  String                    // encrypted at app level
  accountLast4  String
  ifsc          String
  bankName      String?
  verified      Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model Nominee {
  memberId     String @id
  member       Member @relation(fields: [memberId], references: [id])
  name         String
  relation     String
  dob          DateTime?
}

model KycDocument {
  id          String     @id @default(cuid())
  memberId    String
  member      Member     @relation(fields: [memberId], references: [id])
  type        KycDocType
  numberEnc   String?                     // PAN / Aadhaar (masked + encrypted)
  fileKey     String                      // S3 object key
  status      KycStatus  @default(PENDING)
  remarks     String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime   @default(now())
  @@index([memberId])
  @@index([status])
}

// ---------- CATALOGUE ----------
model Product {
  id          Int            @id @default(autoincrement())
  sku         String         @unique
  name        String
  category    String?
  hsnCode     String?
  gstRate     Decimal        @default(18) @db.Decimal(5, 2)
  description String?
  imageUrl    String?
  isActive    Boolean        @default(true)
  prices      ProductPrice[]
  stock       Int            @default(0)
  packageItems PackageItem[]
  orderItems  OrderItem[]
}

model ProductPrice {                       // versioned prices
  id            Int      @id @default(autoincrement())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
  mrp           Decimal  @db.Decimal(12, 2)
  dp            Decimal  @db.Decimal(12, 2)
  bv            Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  @@index([productId, effectiveFrom])
}

model Package {
  id        Int           @id @default(autoincrement())
  code      String        @unique          // BASIC_40, FULL_100, UPGRADE_60
  name      String
  price     Decimal       @db.Decimal(12, 2)
  bv        Decimal       @db.Decimal(12, 2)
  tier      PackageTier                    // tier the member gets after buying
  isUpgrade Boolean       @default(false)
  isActive  Boolean       @default(true)
  items     PackageItem[]
  orders    Order[]
}

model PackageItem {
  id        Int     @id @default(autoincrement())
  packageId Int
  package   Package @relation(fields: [packageId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  @@unique([packageId, productId])
}

// ---------- ORDERS ----------
model Order {
  id           String      @id @default(cuid())
  orderNo      String      @unique
  memberId     String?
  member       Member?     @relation(fields: [memberId], references: [id])
  type         OrderType
  packageId    Int?
  status       OrderStatus @default(PENDING_PAYMENT)
  subTotal     Decimal     @db.Decimal(12, 2)
  gstTotal     Decimal     @db.Decimal(12, 2)
  grandTotal   Decimal     @db.Decimal(12, 2)
  bvTotal      Decimal     @db.Decimal(12, 2)
  shipping     Json?
  franchiseId  String?
  invoiceNo    String?     @unique
  invoiceUrl   String?
  createdAt    DateTime    @default(now())
  paidAt       DateTime?
  items        OrderItem[]
  payments     Payment[]
  bvPostings   BvPosting[]
  returns      ReturnRequest[]
  package      Package?    @relation(fields: [packageId], references: [id])
  @@index([memberId, createdAt])
  @@index([status, paidAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  qty       Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitBv    Decimal @db.Decimal(12, 2)
  gstRate   Decimal @db.Decimal(5, 2)
  product   Product @relation(fields: [productId], references: [id])
  @@index([orderId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  gateway     String
  gatewayRef  String?       @unique
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(CREATED)
  raw         Json?
  createdAt   DateTime      @default(now())
  @@index([orderId])
}

// ---------- ENGINE ----------
model BvPosting {                           // one row per order (or reversal)
  id          String   @id @default(cuid())
  memberId    String                        // buyer
  member      Member   @relation(fields: [memberId], references: [id])
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  bv          Decimal  @db.Decimal(12, 2)   // negative for reversal
  pairUnits   Int      @default(0)          // 1 for a joining / upgrade, else 0
  tier        PackageTier
  postedAt    DateTime @default(now())
  propagated  Boolean  @default(false)      // upline totals updated?
  reversalOf  String?
  @@index([propagated])
  @@index([memberId])
  @@index([orderId])
}

model Closing {
  id           String        @id @default(cuid())
  periodStart  DateTime
  periodEnd    DateTime
  status       ClosingStatus @default(DRAFT)
  settingsVer  Int
  totalPayout  Decimal       @default(0) @db.Decimal(16, 2)
  turnover     Decimal       @default(0) @db.Decimal(16, 2)
  runBy        String?
  approvedBy   String?
  createdAt    DateTime      @default(now())
  postedAt     DateTime?
  lines        ClosingLine[]
  @@unique([periodStart, periodEnd])
}

model ClosingLine {
  id          String     @id @default(cuid())
  closingId   String
  closing     Closing    @relation(fields: [closingId], references: [id])
  memberId    String
  member      Member     @relation(fields: [memberId], references: [id])
  incomeType  IncomeType
  pairs       Int        @default(0)
  rate        Decimal    @default(0) @db.Decimal(12, 2)
  amount      Decimal    @db.Decimal(14, 2)
  flushed     Int        @default(0)
  detail      Json                            // full calculation breakdown
  @@index([memberId])
  @@index([closingId])
}

model Rank {
  id            Int      @id                  // 1..17
  name          String   @unique
  nameHi        String?
  thresholdBv   Decimal  @db.Decimal(16, 2)   // required on EACH leg
  bonusAmount   Decimal  @db.Decimal(16, 2)
  reward        String?
  confirmed     Boolean  @default(false)
  members       Member[]
  achievements  MemberRank[]
}

model MemberRank {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  rankId      Int
  rank        Rank     @relation(fields: [rankId], references: [id])
  achievedAt  DateTime @default(now())
  bonusPaid   Boolean  @default(false)
  rewardStatus String  @default("PENDING")
  @@unique([memberId, rankId])
}

// ---------- WALLET ----------
model Wallet {
  memberId  String      @id
  member    Member      @relation(fields: [memberId], references: [id])
  balance   Decimal     @default(0) @db.Decimal(16, 2)
  onHold    Boolean     @default(false)
  txns      WalletTxn[]
  withdrawals Withdrawal[]
}

model WalletTxn {
  id           String        @id @default(cuid())
  memberId     String
  wallet       Wallet        @relation(fields: [memberId], references: [memberId])
  type         WalletTxnType
  incomeType   IncomeType?
  amount       Decimal       @db.Decimal(14, 2)
  balanceAfter Decimal       @db.Decimal(16, 2)
  refType      String                       // CLOSING_LINE | WITHDRAWAL | ADJUSTMENT | REVERSAL
  refId        String
  note         String?
  createdAt    DateTime      @default(now())
  @@unique([refType, refId, type])          // idempotency: never credit the same thing twice
  @@index([memberId, createdAt])
}

model Withdrawal {
  id          String           @id @default(cuid())
  memberId    String
  wallet      Wallet           @relation(fields: [memberId], references: [memberId])
  gross       Decimal          @db.Decimal(14, 2)
  tds         Decimal          @db.Decimal(14, 2)
  adminCharge Decimal          @db.Decimal(14, 2)
  net         Decimal          @db.Decimal(14, 2)
  status      WithdrawalStatus @default(REQUESTED)
  utr         String?
  approvedBy  String?
  createdAt   DateTime         @default(now())
  paidAt      DateTime?
  @@index([memberId])
  @@index([status])
}

// ---------- SETTINGS, SUPPORT, AUDIT ----------
model PlanSetting {
  id            Int      @id @default(autoincrement())
  version       Int      @unique
  values        Json                      // see Step 4.3
  effectiveFrom DateTime
  createdBy     String
  createdAt     DateTime @default(now())
}

model Ticket {
  id         String       @id @default(cuid())
  memberId   String
  member     Member       @relation(fields: [memberId], references: [id])
  category   String
  subject    String
  status     TicketStatus @default(OPEN)
  slaDueAt   DateTime?
  messages   Json         @default("[]")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  @@index([memberId])
  @@index([status])
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  reason    String
  status    ReturnStatus @default(REQUESTED)
  createdAt DateTime     @default(now())
  @@index([orderId])
}

model PendingAction {                     // maker-checker queue
  id          String              @id @default(cuid())
  action      String
  entity      String
  entityId    String
  payload     Json
  requestedBy String
  decidedBy   String?
  status      PendingActionStatus @default(PENDING)
  reason      String?
  createdAt   DateTime            @default(now())
  decidedAt   DateTime?
  @@index([status])
}

model Counter {                           // atomic number generators (distributor code, order no, invoice no)
  key   String @id
  value Int
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?
  action    String                        // e.g. MEMBER.UPDATE, CLOSING.APPROVE
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
}
