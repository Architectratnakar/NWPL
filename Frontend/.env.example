# ---- copy to .env if you need to change the defaults ----
# Development: where the Vite dev server forwards /api requests (the Backend)
BACKEND_URL=http://localhost:4000

# Production, only if Frontend and Backend are hosted on DIFFERENT domains:
# VITE_API_URL=https://api.your-domain.com/api/v1
# (then set WEB_ORIGIN and COOKIE_SAMESITE=none in Backend/.env)
